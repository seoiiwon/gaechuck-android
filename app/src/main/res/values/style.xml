<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomButtonStyle">
        <item name="android:background">@drawable/rounded_button</item>
        <item name="android:textColor">#000000</item> <!-- 검정색 텍스트 -->
        <item name="android:padding">8dp</item>
    </style>
    <style name="alarm_toggle">
        <item name="thumbTint">@color/white</item>
        <item name="track">@drawable/style_toggle_btn</item>
        <item name="android:thumb">@drawable/style_toggle_thumb</item>
        <item name="android:state_checked">true</item>
    </style>

    <style name="custom_chip_style">
        <item name="backgroundTint">@color/white</item>

    </style>

    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Action">
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PopupMenuStyle">
        <item name="android:textColor">@color/black</item> <!-- 텍스트 색상 -->
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="android:popupBackground">@drawable/custom_popup_background</item>
        <item name="android:popupElevation">5dp</item>
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/menu_button</item>
        <item name="android:backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="ShapeAppearanceOverlay.Fab" parent="">
        <!-- 50%로 지정하면 원형 모양이 됩니다 -->
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomDatePickerDialog" parent="Theme.MaterialComponents.Light.Dialog.Alert">
        <item name="colorPrimary">@color/gnu_blue</item>
        <item name="colorAccent">@color/gnu_lightBlue</item>
        <item name="android:datePickerDialogTheme">@style/CustomDatePickerTheme</item>
    </style>

    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/gnu_blue</item>
        <item name="colorAccent">@color/gnu_blue</item>
        <item name="android:textColorPrimary">@color/gnu_blue</item>
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <style name="ThemeOverlay.App.Dialog" parent="@style/ThemeOverlay.MaterialComponents.Dialog">
        <item name="colorSecondary">@color/gnu_lightBlue</item>
        <item name="colorPrimary">@color/gnu_blue</item>
    </style>

    <style name="ThemeOverlay.AppCompat.Dialog" parent="@style/Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/gnu_blue</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButtonStyled</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButtonStyled</item>
    </style>
    <style name="DialogButtonStyled" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/gnu_blue</item> <!-- button text color -->
    </style>

    <style name="Seq8Cell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/pretendard_bold</item>
        <item name="android:textColor">@color/gnu_blue</item>
        <item name="android:padding">8dp</item>
    </style>
</resources>