<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/divider_grey2" />
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="@color/divider_grey2"/>
        </shape>
        <textColor android:color="@color/black"/> <!-- 텍스트 색상: 흰색 -->
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_tab_bg" />
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="@color/divider_grey2"/>
        </shape>
    </item>
</selector>