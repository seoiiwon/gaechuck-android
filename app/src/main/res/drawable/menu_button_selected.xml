<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D0000FF" /> <!-- gnu_blue (파란색) + 30% 투명도 -->
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="@color/gnu_blue"/>
        </shape>
        <textColor android:color="@color/white"/> <!-- 텍스트 색상: 흰색 -->
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0086C0" /> <!-- gnu_blue (파란색) + 30% 투명도 -->
            <corners android:radius="10dp"/>
            <stroke android:width="2dp" android:color="@color/gnu_blue"/>
        </shape>
    </item>
</selector>