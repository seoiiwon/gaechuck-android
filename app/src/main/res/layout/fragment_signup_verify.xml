<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottomSheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_bottom_sheet"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="180dp">

        <LinearLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            android:gravity="center_horizontal">

            <!-- 드래그 핸들 -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:background="@drawable/rounded_border_8dp"
                android:backgroundTint="#D0D5DD"
                android:layout_marginBottom="24dp"/>

            <!-- 이메일 인증 아이콘 -->
            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/email_certification"
                android:scaleType="fitCenter"
                android:contentDescription="이메일 인증"
                android:layout_marginBottom="20dp"/>

            <!-- 타이틀 (파란색) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="인증번호를 확인해주세요"
                android:textSize="20sp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/renewal_primary"
                android:gravity="center"/>

            <!-- 이메일 안내 -->
            <TextView
                android:id="@+id/tvEmailTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일로\n인증번호를 발송했습니다"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/renewal_text_secondary"
                android:gravity="center"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="8dp"/>

            <!-- OTP 레이블 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="인증번호 5자리를 입력해 주세요"
                android:textSize="13sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/renewal_text_primary"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <!-- OTP 5자리 언더라인 입력 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <EditText
                        android:id="@+id/otp1"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:gravity="center|bottom"
                        android:textSize="22sp"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/renewal_text_primary"
                        android:inputType="number"
                        android:maxLength="1"
                        android:importantForAutofill="no"/>
                    <View
                        android:layout_width="32dp"
                        android:layout_height="1.5dp"
                        android:background="@color/renewal_border"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <EditText
                        android:id="@+id/otp2"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:gravity="center|bottom"
                        android:textSize="22sp"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/renewal_text_primary"
                        android:inputType="number"
                        android:maxLength="1"
                        android:importantForAutofill="no"/>
                    <View
                        android:layout_width="32dp"
                        android:layout_height="1.5dp"
                        android:background="@color/renewal_border"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <EditText
                        android:id="@+id/otp3"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:gravity="center|bottom"
                        android:textSize="22sp"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/renewal_text_primary"
                        android:inputType="number"
                        android:maxLength="1"
                        android:importantForAutofill="no"/>
                    <View
                        android:layout_width="32dp"
                        android:layout_height="1.5dp"
                        android:background="@color/renewal_border"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="6dp">
                    <EditText
                        android:id="@+id/otp4"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:gravity="center|bottom"
                        android:textSize="22sp"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/renewal_text_primary"
                        android:inputType="number"
                        android:maxLength="1"
                        android:importantForAutofill="no"/>
                    <View
                        android:layout_width="32dp"
                        android:layout_height="1.5dp"
                        android:background="@color/renewal_border"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <EditText
                        android:id="@+id/otp5"
                        android:layout_width="36dp"
                        android:layout_height="48dp"
                        android:background="@null"
                        android:gravity="center|bottom"
                        android:textSize="22sp"
                        android:fontFamily="@font/pretendard_bold"
                        android:textColor="@color/renewal_text_primary"
                        android:inputType="number"
                        android:maxLength="1"
                        android:importantForAutofill="no"/>
                    <View
                        android:layout_width="32dp"
                        android:layout_height="1.5dp"
                        android:background="@color/renewal_border"/>
                </LinearLayout>

            </LinearLayout>

            <!-- 타이머 (파란색) -->
            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4:59 후에 인증번호가 만료됩니다"
                android:textSize="13sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/renewal_primary"
                android:layout_marginTop="12dp"/>

            <!-- 인증 완료 버튼 -->
            <TextView
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_renewal_btn_disabled"
                android:text="인증 완료"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="@font/pretendard_semibold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginTop="24dp"/>

            <!-- 재발송 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="코드를 받지 못하셨나요? "
                    android:textSize="13sp"
                    android:fontFamily="@font/pretendard_regular"
                    android:textColor="@color/renewal_text_secondary"/>

                <TextView
                    android:id="@+id/tvResend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="재발송"
                    android:textSize="13sp"
                    android:fontFamily="@font/pretendard_semibold"
                    android:textColor="@color/renewal_primary"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
