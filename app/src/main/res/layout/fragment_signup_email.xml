<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- 헤드라인 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="재학인증을 위한 절차예요 🙌"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/signup_headline_blue"
            android:layout_marginBottom="36dp"/>

        <!-- 타이틀 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="이메일 인증"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/black_1"
            android:layout_marginBottom="16dp"/>

        <!-- 이메일 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이메일"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_signup_input"
                android:hint="예시) 218155223@gnu.ac.kr"
                android:textColorHint="@color/grey"
                android:textSize="13sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/black_1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:inputType="textEmailAddress"
                android:importantForAutofill="no"/>

            <TextView
                android:id="@+id/btnSendCode"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="전송"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/grey"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/red_alert"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"/>

        <LinearLayout
            android:id="@+id/resendRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이메일이 오지 않았나요? "
                android:textSize="13sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/info_grey"/>

            <TextView
                android:id="@+id/tvResend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="재전송"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/renewal_primary"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 인증번호 -->
        <TextView
            android:id="@+id/tvCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증번호"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:visibility="gone"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/codeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_signup_input"
                    android:hint="인증번호 5자리를 입력해 주세요"
                    android:textColorHint="@color/grey"
                    android:textSize="13sp"
                    android:fontFamily="@font/pretendard_regular"
                    android:textColor="@color/black_1"
                    android:paddingStart="12dp"
                    android:paddingEnd="40dp"
                    android:maxLength="5"
                    android:maxLines="1"
                    android:inputType="numberPassword"
                    android:importantForAutofill="no"/>

                <ImageView
                    android:id="@+id/toggleCodeVisibility"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_eye"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@null"/>
            </FrameLayout>

            <TextView
                android:id="@+id/btnVerify"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="인증"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/grey"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/renewal_timer_blue"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"/>

        <TextView
            android:id="@+id/tvVerifyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"/>

        <!-- 다음 버튼 -->
        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_signup_btn_disabled"
            android:text="다음"
            android:textColor="@color/grey"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="48dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
