<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_signup_complete_gradient">

    <!-- 회원가입 완료 아이콘 -->
    <ImageView
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:src="@drawable/success_perspective"
        android:scaleType="fitCenter"
        android:contentDescription="회원가입 완료"/>

    <!-- 타이틀 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="회원가입 완료"
        android:textSize="24sp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="@color/black_1"
        android:layout_marginTop="48dp"/>

    <!-- 서브 메시지 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="로딩중"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/text_secondary_2"
        android:gravity="center"
        android:layout_marginTop="24dp"/>

    <TextView
        android:id="@+id/tvLoadingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="잠시만 기다려주세요..."
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/text_secondary_2"
        android:gravity="center"
        android:layout_marginTop="6dp"/>

</LinearLayout>
