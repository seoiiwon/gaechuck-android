<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_menu_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 식사 유형 행: 뱃지 + 시간 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/mealBadge"
            android:layout_width="44dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_meal_badge"
            android:gravity="center"
            android:text="점심"
            android:textColor="@color/primary_500"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_medium"/>

        <TextView
            android:id="@+id/mealTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="11:30 - 13:30"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_regular"/>

    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/border_default"/>

    <!-- 메뉴 내용 -->
    <TextView
        android:id="@+id/menuContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="@font/pretendard_regular"/>

    <!-- 기존 호환성: divisionTextView, menuTextView (GONE 상태) -->
    <TextView
        android:id="@+id/divisionTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/menuTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

</LinearLayout>
