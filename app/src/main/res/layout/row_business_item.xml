<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:paddingVertical="16dp"
    android:paddingHorizontal="10dp"
    >

    <androidx.cardview.widget.CardView
        android:id="@+id/business_image_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardCornerRadius="16dp">
        <ImageView
            android:id="@+id/business_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="154dp"
        android:layout_height="84dp"
        android:layout_marginLeft="40dp"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="@id/business_image_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/business_image_card"
        >

        <TextView
            android:id="@+id/business_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="1234"
            android:fontFamily="@font/pretendard_semibold"
            android:textSize="16sp"
            />

        <TextView
            android:id="@+id/business_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4sp"
            android:background="@drawable/style_category"
            android:paddingVertical="4dp"
            android:paddingHorizontal="16dp"
            android:text="1111"
            android:textAlignment="center"
            android:textColor="@color/gnu_blue"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/business_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="fjadlfkjadhlfkja"
            android:textAlignment="center"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>