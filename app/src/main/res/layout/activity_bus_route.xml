<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cafeteria">

    <!-- 앱바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/black_1"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="버스 노선"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black_1"
            android:gravity="center"
            android:fontFamily="@font/pretendard_bold"/>

        <ImageView
            android:id="@+id/button_home"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/ic_home"/>

    </LinearLayout>

    <!-- 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- 노선 선택 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:background="@color/white"
                    android:gravity="center_vertical">

                    <!-- 아이콘 컬럼 -->
                    <LinearLayout
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="48dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/ic_departure_circle"/>
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="12dp">
                            <View
                                android:layout_width="1dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:background="@color/renewal_border"/>
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="24dp"
                            android:layout_height="48dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                app:srcCompat="@drawable/ic_arrival_pin"/>
                        </FrameLayout>

                    </LinearLayout>

                    <!-- 텍스트 컬럼 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="vertical"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="출발"
                                android:textSize="11sp"
                                android:textColor="@color/info_grey"
                                android:fontFamily="@font/pretendard_regular"/>

                            <TextView
                                android:id="@+id/fromCampusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="가좌캠퍼스"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/black_1"
                                android:fontFamily="@font/pretendard_bold"/>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:orientation="vertical"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="도착"
                                android:textSize="11sp"
                                android:textColor="@color/info_grey"
                                android:fontFamily="@font/pretendard_regular"/>

                            <TextView
                                android:id="@+id/toCampusText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="칠암캠퍼스"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/black_1"
                                android:fontFamily="@font/pretendard_bold"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- 스왑 버튼 -->
                    <ImageView
                        android:id="@+id/swapButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="11dp"
                        android:background="@drawable/bg_swap_button"
                        android:elevation="2dp"
                        app:srcCompat="@drawable/ic_swap"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 오전/오후 탭 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="20dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tabAm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오전"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/renewal_primary"
                    android:fontFamily="@font/pretendard_bold"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/info_grey"/>

                <TextView
                    android:id="@+id/tabPm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오후"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/info_grey"
                    android:fontFamily="@font/pretendard_bold"/>

            </LinearLayout>

            <!-- 승차 위치 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    app:srcCompat="@drawable/ic_bus_mini"/>

                <TextView
                    android:id="@+id/boardingLocationText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="교양학관 앞 승차"
                    android:textSize="13sp"
                    android:textColor="@color/renewal_primary"
                    android:textStyle="bold"
                    android:fontFamily="@font/pretendard_bold"/>

            </LinearLayout>

            <!-- 시간표 카드 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- 헤더 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="출발시간"
                            android:textSize="11sp"
                            android:textColor="@color/info_grey"
                            android:fontFamily="@font/pretendard_regular"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:background="@color/renewal_border"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="도착시간"
                            android:textSize="11sp"
                            android:textColor="@color/info_grey"
                            android:fontFamily="@font/pretendard_regular"/>

                    </LinearLayout>

                    <!-- 헤더 구분선 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/renewal_border"/>

                    <!-- 시간 목록 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/timeRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>

                    <!-- 운행 안내 -->
                    <TextView
                        android:id="@+id/operationNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="10sp"
                        android:textColor="@color/info_grey"
                        android:fontFamily="@font/pretendard_regular"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
