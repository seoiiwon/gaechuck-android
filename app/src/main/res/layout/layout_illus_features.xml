<?xml version="1.0" encoding="utf-8"?>
<!-- 온보딩 3페이지: 기능 그리드 일러스트 (외부 반투명 컨테이너 + 2×2 이모지 그리드) -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_illus_card"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1행 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_illus_icon_box"
                android:layout_marginEnd="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍚"
                    android:textSize="34sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_illus_icon_box">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺"
                    android:textSize="34sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 2행 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_illus_icon_box"
                android:layout_marginEnd="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📢"
                    android:textSize="34sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_illus_icon_box">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎭"
                    android:textSize="34sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
