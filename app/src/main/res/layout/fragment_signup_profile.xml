<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- 헤드라인 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="개척과 함께 하는 대학생활,\n시작해볼까요?"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/signup_headline_blue"
            android:letterSpacing="-0.025"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="36dp"/>

        <!-- 타이틀 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textSize="20sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/black_1"
            android:layout_marginBottom="16dp"/>

        <!-- 이름 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이름"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_signup_input"
            android:hint="이름"
            android:textColorHint="@color/grey"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/black_1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:importantForAutofill="no"
            android:layout_marginBottom="12dp"/>

        <!-- 학년 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학년"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/gradeHeader"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_signup_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/gradeValueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1학년"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/grey"/>

            <ImageView
                android:id="@+id/gradeChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:rotation="-90"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gradeOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_signup_dropdown_container"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:divider="@drawable/divider_signup_dropdown"
            android:showDividers="middle"/>

        <View
            android:id="@+id/gradeSpacer"
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <!-- 학과 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학과"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:id="@+id/departmentHeader"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_signup_input"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/departmentValueText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="학과 선택"
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/grey"/>

            <ImageView
                android:id="@+id/departmentChevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_back"
                android:rotation="-90"
                android:contentDescription="@null"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/departmentOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_signup_dropdown_container"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:divider="@drawable/divider_signup_dropdown"
            android:showDividers="middle"/>

        <!-- 다음 버튼 -->
        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_signup_btn_disabled"
            android:text="다음"
            android:textColor="@color/grey"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="48dp"/>

        <!-- 구분선 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/signup_divider"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="또는"
                android:textSize="12sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/grey"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/signup_divider"/>
        </LinearLayout>

        <!-- 로그인 유도 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이미 계정이 있으신가요? "
                android:textSize="14sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/info_grey"/>

            <TextView
                android:id="@+id/tvGoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="로그인"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="@color/renewal_primary"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- 비로그인 -->
        <TextView
            android:id="@+id/tvGuest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="비로그인으로 시작하기 &gt;"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/grey"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
