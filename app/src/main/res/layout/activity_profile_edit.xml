<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.mypage.ProfileEditActivity">

    <View
        android:id="@+id/gradient_wash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_mypage_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nickname_label" />

    <ImageView
        android:id="@+id/button_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="54dp"
        app:srcCompat="@drawable/ic_back"
        app:tint="@color/black_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:text="마이"
        android:textColor="@color/black_1"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="@id/button_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/save_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="저장"
        android:textColor="@color/brand_2"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/button_back"
        app:layout_constraintBottom_toBottomOf="@id/button_back"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/avatar_frame"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/button_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/circle_avatar_brand2" />

        <ImageView
            android:id="@+id/camera_badge"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_camera_badge"
            android:padding="7dp"
            app:srcCompat="@drawable/ic_camera"
            app:tint="@color/text_secondary_2" />
    </FrameLayout>

    <TextView
        android:id="@+id/nickname_display_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/pretendard_semibold"
        android:textColor="@color/black_1"
        android:textSize="16sp"
        tools:text="우울한 대학생1"
        app:layout_constraintTop_toBottomOf="@id/avatar_frame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dept_grade_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/text_secondary_2"
        android:textSize="14sp"
        tools:text="컴퓨터공학부 · 3학년"
        app:layout_constraintTop_toBottomOf="@id/nickname_display_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 닉네임 수정 -->
    <TextView
        android:id="@+id/nickname_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="닉네임 수정"
        android:textColor="@color/black_1"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/dept_grade_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/nickname_edit_text"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_profile_edit_field"
        android:paddingHorizontal="12dp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/grey"
        android:textColorHint="@color/grey"
        android:textSize="14sp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:singleLine="true"
        android:inputType="text"
        tools:text="우울한 대학생1"
        app:layout_constraintTop_toBottomOf="@id/nickname_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/nickname_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="24dp"
        android:fontFamily="@font/pretendard_regular"
        android:text="한글, 영어 포함 6자 이내로 작성해주세요"
        android:textColor="@color/info_grey"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/nickname_edit_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 학과 수정 -->
    <TextView
        android:id="@+id/department_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="학과 수정"
        android:textColor="@color/black_1"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/nickname_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/department_row"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_profile_edit_field"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/department_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/department_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/grey"
            android:textSize="14sp"
            tools:text="컴퓨터공학부" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- 학년 수정 -->
    <TextView
        android:id="@+id/grade_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="학년 수정"
        android:textColor="@color/black_1"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/department_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/grade_row"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_profile_edit_field"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toBottomOf="@id/grade_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/grade_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/grey"
            android:textSize="14sp"
            tools:text="3" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            app:srcCompat="@drawable/ic_chevron_down" />
    </LinearLayout>

    <!-- 아이디 수정 (읽기 전용) -->
    <TextView
        android:id="@+id/student_id_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/pretendard_semibold"
        android:text="아이디 수정"
        android:textColor="@color/black_1"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/grade_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/student_id_value"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_profile_edit_field"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="@color/grey"
        android:textSize="14sp"
        tools:text="202012345"
        app:layout_constraintTop_toBottomOf="@id/student_id_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_include" />

    <include
        android:id="@+id/bottom_nav_include"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
