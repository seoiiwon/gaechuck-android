<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_cafeteria_section"
    android:animateLayoutChanges="true"
    android:elevation="2dp">

    <!-- Header: 섹션 제목 + 화살표 -->
    <LinearLayout
        android:id="@+id/sectionHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#111111"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_semibold"/>

        <ImageView
            android:id="@+id/chevronIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_up"
            android:contentDescription="펼치기/접기"/>

    </LinearLayout>

    <!-- 펼쳐지는 메뉴 내용 -->
    <LinearLayout
        android:id="@+id/sectionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="24dp">

        <!-- 운영 시간 (빈 경우 gone) -->
        <TextView
            android:id="@+id/sectionTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#0047AB"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_semibold"/>

        <!-- 메뉴 목록 -->
        <TextView
            android:id="@+id/sectionMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#111111"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_medium"
            android:lineSpacingMultiplier="1.5"
            android:lineSpacingExtra="0dp"/>

    </LinearLayout>

</LinearLayout>
