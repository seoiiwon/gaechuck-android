<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ui.club.ClubDetailFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/cover_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:background="@color/bg_cafeteria" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/club_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:textColor="@color/black_1"
                    android:textSize="20sp"
                    tools:text="FC 개척" />

                <TextView
                    android:id="@+id/club_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:textColor="@color/info_grey"
                    android:textSize="14sp"
                    tools:text="중앙동아리 / 스포츠" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/club_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/pretendard_medium"
                        android:textSize="13sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        tools:text="모집중" />

                    <TextView
                        android:id="@+id/club_beginner_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_club_badge_neutral"
                        android:fontFamily="@font/pretendard_medium"
                        android:text="초보환영"
                        android:textColor="@color/text_secondary_2"
                        android:textSize="13sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/club_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:tabIndicatorColor="@color/brand_2"
                app:tabSelectedTextColor="@color/brand_2"
                app:tabTextColor="@color/grey"
                app:tabMode="fixed">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="소개" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모집일정" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="활동사진" />

            </com.google.android.material.tabs.TabLayout>

            <!-- 소개 tab -->
            <LinearLayout
                android:id="@+id/intro_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard_bold"
                    android:text="동아리 소개"
                    android:textColor="@color/black_1"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/intro_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/pretendard_regular"
                    android:textColor="@color/black_1"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="동아리 소개 내용" />

                <LinearLayout
                    android:id="@+id/activity_info_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="활동 안내"
                        android:textColor="@color/black_1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/meeting_info_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/text_secondary_2"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="정기모임 : 매주 수요일 18:00 대운동장" />

                    <TextView
                        android:id="@+id/fee_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/text_secondary_2"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="회비: 학기당 30,000원" />

                    <TextView
                        android:id="@+id/preparation_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/pretendard_regular"
                        android:textColor="@color/text_secondary_2"
                        android:textSize="14sp"
                        android:visibility="gone"
                        tools:text="준비물: 개인 축구화 및 운동복" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contact_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/pretendard_bold"
                        android:text="연락처"
                        android:textColor="@color/black_1"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/contact_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_contact_chip"
                        android:drawableEnd="@drawable/ic_open_in_new"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/pretendard_medium"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:textColor="@color/brand_2"
                        android:textSize="14sp"
                        tools:text="인스타그램 ↗" />

                </LinearLayout>

            </LinearLayout>

            <!-- 모집일정 tab -->
            <LinearLayout
                android:id="@+id/schedule_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/schedule_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:fontFamily="@font/pretendard_regular"
                android:text="모집일정이 아직 등록되지 않았습니다"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- 활동사진 tab -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gallery_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="22dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:clipToPadding="false"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gallery_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp"
                android:gravity="center"
                android:fontFamily="@font/pretendard_regular"
                android:text="사진이 아직 등록되지 않았습니다"
                android:textColor="@color/grey"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="8dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Sticky bottom action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@color/white"
        android:elevation="4dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/apply_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_lose_inquiry_btn"
            android:fontFamily="@font/pretendard_semibold"
            android:text="지원하기"
            android:textColor="@color/white"
            android:textSize="16sp"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>
