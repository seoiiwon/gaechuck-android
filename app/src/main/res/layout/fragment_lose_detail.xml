<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <!-- Image card (221dp × 221dp, rounded-24dp) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="221dp"
                android:layout_height="221dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_cafeteria">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/lose_images_viewpager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/lose_icon_placeholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📦"
                        android:textSize="64sp" />

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Dot indicator -->
            <com.tbuonomo.viewpagerdotsindicator.WormDotsIndicator
                android:id="@+id/image_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:dotsColor="@color/renewal_primary"
                app:dotsStrokeColor="#E5E5EC"
                app:dotsSize="8dp"
                app:dotsStrokeWidth="1.5dp" />

            <!-- Item title (centered, 20sp Bold) -->
            <TextView
                android:id="@+id/lose_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_bold"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#F1F3F5" />

            <!-- Section: 분실물 접수 날짜 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="#111111"
                android:textSize="18sp"
                android:text="분실물 접수 날짜" />

            <TextView
                android:id="@+id/lose_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="#505050"
                android:textSize="14sp" />

            <!-- Section: 습득 장소 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="#111111"
                android:textSize="18sp"
                android:text="습득 장소" />

            <TextView
                android:id="@+id/lose_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="#505050"
                android:textSize="14sp" />

            <!-- Section: 기타 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="#0047AB"
                android:textSize="18sp"
                android:text="기타" />

            <TextView
                android:id="@+id/lose_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/pretendard_bold"
                android:textColor="#0047AB"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom button area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@color/white">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/chat_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_lose_inquiry_btn"
            android:fontFamily="@font/pretendard_semibold"
            android:text="분실물 문의하기 ↗"
            android:textColor="@color/white"
            android:textSize="16sp"
            style="?android:attr/borderlessButtonStyle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/pretendard_regular"
            android:gravity="center"
            android:text="총학생회 오픈채팅방으로 연결합니다"
            android:textColor="#999999"
            android:textSize="12sp" />

        <!-- Admin-only: mark as found -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/found_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_lose_btn_found"
            android:fontFamily="@font/pretendard_medium"
            android:text="찾았어요 ✓"
            android:textColor="@color/lose_status_done_text"
            android:textSize="14sp"
            android:visibility="gone"
            style="?android:attr/borderlessButtonStyle" />

    </LinearLayout>

</LinearLayout>
