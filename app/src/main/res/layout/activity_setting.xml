<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cafeteria"
    tools:context=".ui.setting.SettingActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="54dp"
            app:srcCompat="@drawable/ic_back"
            app:tint="@color/black_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="설정"
            android:textColor="@color/black_1"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="@id/button_back"
            app:layout_constraintBottom_toBottomOf="@id/button_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_include">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp">

            <!-- 공지 알림 -->
            <TextView
                style="@style/SettingSectionTitle"
                android:text="공지 알림" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/toggle_council_notice"
                    layout="@layout/row_setting_toggle" />

                <include
                    android:id="@+id/toggle_univ_notice"
                    layout="@layout/row_setting_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 앱 설정 -->
            <TextView
                style="@style/SettingSectionTitle"
                android:layout_marginTop="40dp"
                android:text="앱 설정" />

            <include
                android:id="@+id/toggle_dark_mode"
                layout="@layout/row_setting_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <!-- 빠른 정보 커스텀 -->
            <TextView
                style="@style/SettingSectionTitle"
                android:layout_marginTop="40dp"
                android:text="빠른 정보 커스텀" />

            <TextView
                style="@style/SettingSubTitle"
                android:layout_marginTop="2dp"
                android:text="가좌캠퍼스" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/toggle_gajwa_staff"
                    layout="@layout/row_setting_toggle" />

                <include
                    android:id="@+id/toggle_gajwa_culture"
                    layout="@layout/row_setting_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <include
                    android:id="@+id/toggle_gajwa_central"
                    layout="@layout/row_setting_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <TextView
                style="@style/SettingSubTitle"
                android:layout_marginTop="25dp"
                android:text="칠암캠퍼스" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/toggle_chiram_staff"
                    layout="@layout/row_setting_toggle" />

                <include
                    android:id="@+id/toggle_chiram_central"
                    layout="@layout/row_setting_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- 기타 -->
            <TextView
                style="@style/SettingSectionTitle"
                android:layout_marginTop="40dp"
                android:text="기타" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/terms_row"
                    layout="@layout/row_setting_link" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/withdraw_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="13dp"
                        android:fontFamily="@font/pretendard_medium"
                        android:text="회원 탈퇴"
                        android:textColor="@color/red_alert"
                        android:textSize="14sp" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottom_nav_include"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
