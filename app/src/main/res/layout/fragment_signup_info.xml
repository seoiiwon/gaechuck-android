<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- 헤드라인 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="개척과 함께 하는 대학생활,\n시작해볼까요?"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/signup_headline_blue"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="36dp"/>

        <!-- 타이틀 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="회원가입"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/black_1"
            android:layout_marginBottom="16dp"/>

        <!-- 아이디 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="아이디"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginBottom="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <EditText
                android:id="@+id/etId"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_signup_input"
                android:hint="영문, 숫자 포함 6자 이내로 작성해 주세요"
                android:textColorHint="@color/grey"
                android:textSize="13sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/black_1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:maxLines="1"
                android:importantForAutofill="no"/>

            <TextView
                android:id="@+id/btnCheckId"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="중복 확인"
                android:textSize="15sp"
                android:fontFamily="@font/pretendard_medium"
                android:textColor="@color/grey"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvIdStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"/>

        <!-- 비밀번호 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_signup_input"
                android:hint="영문, 숫자, 특수문자 포함 6자 이내로 작성해 주세요"
                android:textColorHint="@color/grey"
                android:textSize="13sp"
                android:fontFamily="@font/pretendard_regular"
                android:textColor="@color/black_1"
                android:paddingStart="12dp"
                android:paddingEnd="40dp"
                android:maxLines="1"
                android:inputType="textPassword"
                android:importantForAutofill="no"/>

            <ImageView
                android:id="@+id/togglePasswordVisibility"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_eye"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@null"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tvPasswordStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/red_alert"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"/>

        <!-- 비밀번호 확인 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="비밀번호 확인"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:textColor="@color/black_1"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/etPasswordConfirm"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_signup_input"
            android:hint="비밀번호 확인"
            android:textColorHint="@color/grey"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/black_1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:inputType="textPassword"
            android:importantForAutofill="no"/>

        <TextView
            android:id="@+id/tvPasswordConfirmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="비밀번호가 일치하지 않습니다"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/red_alert"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:paddingStart="2dp"/>

        <!-- 다음 버튼 -->
        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_signup_btn_disabled"
            android:text="다음"
            android:textColor="@color/grey"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_medium"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="48dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
