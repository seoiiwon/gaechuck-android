<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- 상단 일러스트 영역 (그라데이션 직접 적용) -->
    <FrameLayout
        android:id="@+id/illustrationArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_splash_gradient">

        <!-- 폰 목업 카드 (중앙 배치) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/phoneFrame"
            android:layout_width="196dp"
            android:layout_height="254dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFFFFF">

            <include layout="@layout/layout_phone_mockup"/>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <!-- 하단 텍스트 영역 (투명 → 흰색 패널 위에 표시) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.72"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="104dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/renewal_text_primary"
            android:lineSpacingMultiplier="1.25"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_regular"
            android:textColor="@color/renewal_text_secondary"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.5"/>

    </LinearLayout>

</LinearLayout>
