<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/fragment_notice_council"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

        <!-- 이미지 영역 -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            android:background="@color/tab_colors">

            <ImageView
                android:id="@+id/noticeImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/imagePlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="image"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:visibility="visible" />
        </FrameLayout>

        <!-- 텍스트 영역 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 제목 -->
        <TextView
            android:id="@+id/noticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="물품대여사업 안내 사항"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 내용 -->
        <TextView
            android:id="@+id/noticeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="안녕하세요 경상국립대 개척학우 여러분..."
            android:textColor="@color/tab_colors"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- 날짜 -->
            <TextView
                android:id="@+id/noticeDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="2024.12.12"
                android:textColor="@color/tab_colors"
                android:textSize="10sp" />

            <Button
                android:id="@+id/notice_update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:padding="0dp"
                android:text="수정하기"
                android:textColor="@color/gnu_blue"
                android:textSize="10dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/notice_delete_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/transparent"
                android:padding="0dp"
                android:text="삭제하기"
                android:textColor="@color/gnu_blue"
                android:textSize="10dp"
                android:visibility="gone"/>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>
