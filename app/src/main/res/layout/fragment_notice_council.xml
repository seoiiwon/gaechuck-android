<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_notice_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="14dp"
    android:gravity="top"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Thumbnail: 90×112dp, 4dp corner radius via CardView clip -->
    <androidx.cardview.widget.CardView
        android:layout_width="90dp"
        android:layout_height="112dp"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/noticeImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/bg_muted"
            android:contentDescription="공지 이미지"/>

    </androidx.cardview.widget.CardView>

    <!-- Text content: height=104dp (112-8), marginTop=8dp so bottom aligns with image -->
    <LinearLayout
        android:id="@+id/textContent"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:fontFamily="@font/pretendard_semibold"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="공지 제목"/>

        <TextView
            android:id="@+id/noticeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#505050"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="공지 내용 미리보기"/>

        <!-- Spacer: pushes date to the bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/noticeDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#767676"
            android:textSize="12sp"
            android:fontFamily="@font/pretendard_regular"
            android:gravity="end"
            android:text="2026.01.01"/>

    </LinearLayout>

    <!-- Hidden compat views (kept for adapter backward-compat) -->
    <TextView android:id="@+id/badgeView" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <android.widget.ImageButton android:id="@+id/more_button" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

</LinearLayout>
